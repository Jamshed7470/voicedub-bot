# Секреты — НИКОГДА не коммитить.
# Шаблон .env.* нужен обязательно: резервная копия вида .env.backup-2008
# содержит те же ключи, а правило только для «.env» её не покрывает —
# и `git add -A` утаскивает её в коммит.
.env
.env.*
!.env.example

# Виртуальное окружение
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Данные задач и логи
data/
logs/
*.log

# ВНИМАНИЕ: studio/static/ НЕ игнорируется намеренно — собранный
# интерфейс коммитится, чтобы студия запускалась без Node (решение D-11)

# Веса моделей и кэши
models/
.cache/
wav2vec2_checkpoints/

# Готовые результаты дубляжа
готовые видео/

# Банк голосов: сами образцы (male_*/female_* .wav) — версионируем,
# а исходные демо-нарезки дикторов (сотни МБ) — нет
voice_db/мужской голос/
voice_db/женские  голос/
voice_db/детский голос/
voice_db/.claude-flow/

# IDE
.idea/
.vscode/

# Служебные файлы инструментов
.claude-flow/


# локальный Bot API сервер
telegram-api/data/
telegram-api/.env

# Frontend студии: исходники версионируем, зависимости — нет
studio/frontend/node_modules/
studio/frontend/dist/

# Банк голосов: собирается локально скриптом build_voice_bank
# (латенты XTTS весят десятки МБ и зависят от версии модели)
voices/bank/

# Фикстуры: генерируются скриптом make_fixtures (аудио весит десятки МБ),
# в репозитории живёт только разметка truth.json
tests/fixtures/*/audio*.wav
