# ============ VoiceDub Bot — пример файла .env ============
# Скопируйте этот файл в .env и заполните значения.

# Токен Telegram-бота: получить у @BotFather командой /newbot
BOT_TOKEN=

# Токен HuggingFace (ОБЯЗАТЕЛЕН для определения спикеров) — см. README.md
HF_TOKEN=

# Ключ Anthropic API (необязательно, для перевода через Claude)
ANTHROPIC_API_KEY=

# Ключ xAI (Grok) — для «уличного» режима перевода (необязательно)
XAI_API_KEY=

# Адрес локального сервера telegram-bot-api (необязательно)
TELEGRAM_LOCAL_API_URL=

# Устройство: auto | cuda | cpu
DEVICE=auto

# Профиль моделей: full | light
MODEL_PROFILE=full

# ---- Studio v2: интерфейс проверки голосов перед рендером (НЕобязательно) ----
# Выключено по умолчанию: при false бот работает ровно как раньше.
STUDIO_ENABLED=false

# Ключ подписи ссылок на студию, не короче 32 символов.
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(48))"
STUDIO_SECRET=

# Адрес, по которому студия доступна снаружи — он попадёт в ссылку в Telegram.
# Локально: http://localhost:8080   На сервере: http://<ip-сервера>:8080
STUDIO_PUBLIC_URL=
