# ============ VoiceDub Bot — пример файла .env ============
# Скопируйте этот файл в .env и заполните значения.

# Токен Telegram-бота: получить у @BotFather командой /newbot
BOT_TOKEN=

# Токен HuggingFace (ОБЯЗАТЕЛЕН для определения спикеров) — см. README.md
HF_TOKEN=

# Ключ Anthropic API (необязательно, для перевода через Claude)
ANTHROPIC_API_KEY=

# Ключ xAI (Grok) — для «уличного» режима перевода (необязательно)
XAI_API_KEY=

# Адрес локального сервера telegram-bot-api (необязательно)
TELEGRAM_LOCAL_API_URL=

# Устройство: auto | cuda | cpu
DEVICE=auto

# Профиль моделей: full | light
MODEL_PROFILE=full
